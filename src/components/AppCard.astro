---
import type { CollectionEntry } from 'astro:content';

interface Props {
  app: CollectionEntry<'apps'>;
  /** Position in the grid, used to stagger the entrance animation. */
  index?: number;
}

const { app, index = 0 } = Astro.props;
const slug = app.data.slug ?? app.slug;
const { name, tagline, icon, platforms, accent } = app.data;

const platformLabels: Record<string, string> = {
  ios: 'iOS',
  android: 'Android',
  web: 'Web',
  windows: 'Windows',
  macos: 'macOS',
  linux: 'Linux',
};
---

<a
  href={`/apps/${slug}/`}
  class="app-card reveal group block rounded-2xl border border-line bg-surface p-6 transition-[translate,scale,border-color,box-shadow] duration-300 ease-out hover:-translate-y-1 active:scale-[0.985]"
  style={`--app-accent: var(--su-${accent}); --reveal-delay: ${index * 90}ms`}
>
  <img
    src={icon}
    alt=""
    width="64"
    height="64"
    loading="lazy"
    class="size-16 rounded-[18px]"
    transition:name={`app-icon-${slug}`}
  />
  <h3 class="mt-5 font-display text-xl font-medium tracking-tight">{name}</h3>
  <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{tagline}</p>
  {
    platforms.length > 0 && (
      <p class="mt-4 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-muted">
        {platforms.map((p) => platformLabels[p]).join(' · ')}
      </p>
    )
  }
</a>

<style>
  .app-card:hover {
    border-color: var(--app-accent);
    box-shadow: 0 12px 32px -16px var(--app-accent);
  }
</style>
