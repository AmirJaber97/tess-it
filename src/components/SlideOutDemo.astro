---
// Looping CSS demo of SlideNote's slide-out panel. Pure CSS; under
// prefers-reduced-motion the panel rests in the open state (no movement).
// Accent color is inherited from --app-accent set on a page ancestor.
---

<div class="demo" role="img" aria-label="SlideNote sliding in from the left edge of the screen, then sliding away">
  <div class="wall">
    <div class="menubar">
      <span class="mb-dot"></span>
      <span class="mb-title">SlideNote</span>
      <span class="mb-clock">9:41</span>
    </div>

    <!-- cursor nudging the left edge to trigger the slide -->
    <span class="cursor" aria-hidden="true"></span>

    <div class="panel">
      <span class="p-eyebrow">SLIDENOTE</span>
      <span class="p-title">Quick thought</span>
      <span class="p-line" style="width: 82%"></span>
      <span class="p-line" style="width: 64%"></span>
      <span class="p-line accent" style="width: 72%"></span>
      <span class="p-caret"></span>
      <span class="p-hint">⌘⇧⌥N</span>
    </div>
  </div>
</div>

<style>
  .demo {
    border: 1px solid var(--su-border);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 24px 60px -32px var(--app-accent, #000);
  }

  .wall {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, #2a2440, #3d2740);
    overflow: hidden;
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 8%;
    min-height: 22px;
    padding: 0 0.75rem;
    background: rgb(14 12 22 / 0.55);
    font-family: var(--font-mono);
    font-size: clamp(9px, 1.4vw, 12px);
    color: #f4efe4;
  }
  .mb-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--app-accent, #ffc14d);
  }
  .mb-title {
    font-weight: 600;
  }
  .mb-clock {
    margin-left: auto;
    color: #cfc9d8;
  }

  .panel {
    position: absolute;
    top: 8%;
    bottom: 0;
    left: 0;
    width: 42%;
    padding: 7% 6%;
    display: flex;
    flex-direction: column;
    gap: 3.5%;
    background: #fbf5ea;
    border-right: 3px solid var(--app-accent, #ffc14d);
    box-shadow: 14px 0 40px -10px rgb(0 0 0 / 0.45);
    animation: slide 6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .p-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(8px, 1.1vw, 10px);
    letter-spacing: 0.18em;
    color: #9a8f7a;
  }
  .p-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(13px, 2.2vw, 20px);
    color: #221f1a;
    margin-bottom: 2%;
  }
  .p-line {
    height: clamp(6px, 1vw, 9px);
    border-radius: 999px;
    background: #e7dfce;
  }
  .p-line.accent {
    background: color-mix(in srgb, var(--app-accent, #f08c42) 55%, #e7dfce);
  }
  .p-caret {
    width: 2px;
    height: clamp(12px, 2vw, 18px);
    margin-top: 2%;
    background: var(--app-accent, #f08c42);
    animation: caret 1.1s steps(2, start) infinite;
  }
  .p-hint {
    margin-top: auto;
    align-self: flex-start;
    padding: 0.3em 0.6em;
    border-radius: 0.5em;
    background: #f3ecdc;
    font-family: var(--font-mono);
    font-size: clamp(9px, 1.3vw, 12px);
    color: #6e675c;
  }

  .cursor {
    position: absolute;
    top: 55%;
    left: 6%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fffdf7;
    box-shadow: 0 0 0 2px rgb(0 0 0 / 0.3);
    animation: nudge 6s ease-in-out infinite;
  }

  @keyframes slide {
    0% {
      transform: translateX(-104%);
    }
    10%,
    46% {
      transform: translateX(0);
    }
    56%,
    100% {
      transform: translateX(-104%);
    }
  }

  @keyframes nudge {
    0% {
      transform: translate(40px, 0);
      opacity: 0;
    }
    6% {
      transform: translate(0, 0);
      opacity: 1;
    }
    12%,
    50% {
      transform: translate(0, 0);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes caret {
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
      transform: none;
    }
    .cursor,
    .p-caret {
      display: none;
    }
  }
</style>
