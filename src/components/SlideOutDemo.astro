---
// Looping CSS demo of SlideNote's slide-out panel. Pure CSS; under
// prefers-reduced-motion the panel rests in the open state (no movement).
// Accent color is inherited from --app-accent set on a page ancestor.
---

<div class="demo" role="img" aria-label="SlideNote sliding in from the left edge of the screen, then sliding away">
  <div class="wall">
    <div class="menubar">
      <span class="mb-dot"></span>
      <span class="mb-title">SlideNote</span>
      <span class="mb-clock">9:41</span>
    </div>

    <!-- cursor nudging the left edge to trigger the slide -->
    <span class="cursor" aria-hidden="true"></span>

    <div class="panel">
      <div class="p-tabs">
        <span class="p-tab is-active">Untitled</span>
        <span class="p-tab">Reading list</span>
        <span class="p-tab">Recipes</span>
      </div>
      <div class="p-toolbar">
        <b>B</b><i>I</i><u>U</u>
        <span class="p-sep"></span>
        <span class="p-mono">14pt</span>
      </div>
      <span class="p-title">Quick thought</span>
      <span class="p-line" style="width: 86%"></span>
      <span class="p-line" style="width: 68%"></span>
      <span class="p-line accent" style="width: 76%"></span>
      <span class="p-caret"></span>
      <span class="p-hint">⌘⇧⌥N</span>
    </div>
  </div>
</div>

<style>
  .demo {
    border: 1px solid var(--su-border);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 24px 60px -32px var(--app-accent, #000);
  }

  .wall {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, #2a2440, #3d2740);
    overflow: hidden;
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 8%;
    min-height: 22px;
    padding: 0 0.75rem;
    background: rgb(14 12 22 / 0.55);
    font-family: var(--font-mono);
    font-size: clamp(9px, 1.4vw, 12px);
    color: #f4efe4;
  }
  .mb-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--app-accent, #ffc14d);
  }
  .mb-title {
    font-weight: 600;
  }
  .mb-clock {
    margin-left: auto;
    color: #cfc9d8;
  }

  .panel {
    position: absolute;
    top: 8%;
    bottom: 0;
    left: 0;
    width: 44%;
    padding: 5% 5.5%;
    display: flex;
    flex-direction: column;
    gap: 3%;
    background: #f4ecd9;
    border-right: 3px solid var(--app-accent, #ffc14d);
    box-shadow: 14px 0 40px -10px rgb(0 0 0 / 0.45);
    animation: slide 6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .p-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 1%;
  }
  .p-tab {
    padding: 0.2em 0.55em;
    border-radius: 999px;
    background: #e7dcc2;
    color: #7a7259;
    font-size: clamp(7px, 1vw, 11px);
    white-space: nowrap;
  }
  .p-tab.is-active {
    background: color-mix(in srgb, var(--app-accent, #f0a93b) 28%, #f4ecd9);
    color: #6a4c14;
    font-weight: 600;
  }

  .p-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: #6b6354;
    font-size: clamp(8px, 1.15vw, 12px);
  }
  .p-toolbar b {
    color: #2b2722;
  }
  .p-toolbar i {
    font-style: italic;
  }
  .p-toolbar u {
    text-decoration: underline;
  }
  .p-sep {
    width: 1px;
    height: 1em;
    background: #d8ccae;
  }
  .p-mono {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .p-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(13px, 2.1vw, 19px);
    color: #221f1a;
    margin-top: 2%;
    margin-bottom: 1%;
  }
  .p-line {
    height: clamp(6px, 1vw, 9px);
    border-radius: 999px;
    background: #e3d8bd;
  }
  .p-line.accent {
    background: color-mix(in srgb, var(--app-accent, #f08c42) 55%, #e3d8bd);
  }
  .p-caret {
    width: 2px;
    height: clamp(12px, 2vw, 18px);
    margin-top: 1.5%;
    background: var(--app-accent, #f08c42);
    animation: caret 1.1s steps(2, start) infinite;
  }
  .p-hint {
    margin-top: auto;
    align-self: flex-start;
    padding: 0.3em 0.6em;
    border-radius: 0.5em;
    background: #e7dcc2;
    font-family: var(--font-mono);
    font-size: clamp(9px, 1.3vw, 12px);
    color: #6e675c;
  }

  .cursor {
    position: absolute;
    top: 55%;
    left: 6%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fffdf7;
    box-shadow: 0 0 0 2px rgb(0 0 0 / 0.3);
    animation: nudge 6s ease-in-out infinite;
  }

  @keyframes slide {
    0% {
      transform: translateX(-104%);
    }
    10%,
    46% {
      transform: translateX(0);
    }
    56%,
    100% {
      transform: translateX(-104%);
    }
  }

  @keyframes nudge {
    0% {
      transform: translate(40px, 0);
      opacity: 0;
    }
    6% {
      transform: translate(0, 0);
      opacity: 1;
    }
    12%,
    50% {
      transform: translate(0, 0);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes caret {
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
      transform: none;
    }
    .cursor,
    .p-caret {
      display: none;
    }
  }
</style>
