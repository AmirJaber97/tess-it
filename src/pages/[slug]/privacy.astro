---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps', ({ data }) => data.published);
  return apps.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = entry.data.slug ?? entry.slug;
const { name, icon, accent, supportEmail, privacyNote } = entry.data;

const lastUpdated = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(
  entry.data.releaseDate
);

const summary =
  privacyNote ??
  `${name} does not collect, store, or transmit any personal information. There are no accounts, no analytics, and no tracking.`;

// Sections accurate for a local-first, no-data app. Edit per app if a
// future app behaves differently.
const sections = [
  {
    title: 'What gets collected',
    body: `Nothing. ${name} has no analytics, no advertising SDKs, no crash trackers, and no accounts. It never sends your content anywhere.`,
  },
  {
    title: 'Where your data lives',
    body: `Your notes and settings are stored locally on your device. They are yours — easy to back up, and impossible for me or anyone else to read remotely.`,
  },
  {
    title: 'Purchases',
    body: `If ${name} is paid or offers in-app purchases, payments are handled entirely by Apple. I receive anonymized sales figures and never see your payment details.`,
  },
  {
    title: 'Changes to this policy',
    body: `If this policy ever changes, the date above will be updated and any meaningful change will be noted in the App Store release notes.`,
  },
  {
    title: 'Contact',
    body: `Questions about privacy? Email ${supportEmail} and I’ll get back to you.`,
  },
];
---

<BaseLayout title={`${name} Privacy Policy — Tess It`} description={`Privacy policy for ${name}.`}>
  <div class="mx-auto max-w-2xl px-6 pt-12" style={`--app-accent: var(--su-${accent})`}>
    <a
      href={`/${slug}/`}
      class="inline-flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted transition-colors hover:text-ink"
    >
      <img
        src={icon}
        alt=""
        width="24"
        height="24"
        class="size-6 rounded-md"
        transition:name={`app-icon-${slug}`}
      />
      ← {name}
    </a>

    <p class="eyebrow mt-12">Privacy</p>
    <h1 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">
      {name} privacy policy
    </h1>
    <p class="mt-4 font-mono text-xs text-ink-muted">Last updated {lastUpdated}</p>

    <!-- The answer most visitors came for, up front. -->
    <div class="tldr mt-8 rounded-2xl border border-line bg-surface p-6 sm:p-7">
      <p class="eyebrow">The short version</p>
      <p class="mt-3 leading-relaxed">{summary}</p>
    </div>

    <div class="mt-6">
      {
        sections.map((section) => (
          <section>
            <h2 class="mt-10 font-display text-xl font-medium tracking-tight">{section.title}</h2>
            <p class="mt-3 leading-relaxed text-ink-muted">{section.body}</p>
          </section>
        ))
      }
    </div>

    <p class="mt-14 font-mono text-xs text-ink-muted">
      Need help instead? Visit <a
        href={`/${slug}/support/`}
        class="text-accent underline underline-offset-4">{name} support</a
      >.
    </p>
  </div>
</BaseLayout>

<style>
  .tldr {
    border-left: 4px solid var(--app-accent);
  }
</style>
