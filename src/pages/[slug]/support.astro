---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps', ({ data }) => data.published);
  return apps.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = entry.data.slug ?? entry.slug;
const { name, icon, accent, supportEmail, responseTime, quickStart, faq, privacyNote } = entry.data;

const mailto = `mailto:${supportEmail}?subject=${encodeURIComponent(`${name} — support`)}`;
---

<BaseLayout title={`${name} Support — Tess It`} description={`Get help with ${name}.`}>
  <div class="mx-auto max-w-2xl px-6 pt-12" style={`--app-accent: var(--su-${accent})`}>
    <a
      href={`/${slug}/`}
      class="inline-flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted transition-colors hover:text-ink"
    >
      <img
        src={icon}
        alt=""
        width="24"
        height="24"
        class="size-6 rounded-md"
        transition:name={`app-icon-${slug}`}
      />
      ← {name}
    </a>

    <p class="eyebrow mt-12">Support</p>
    <h1 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">How can I help?</h1>

    <!-- The fastest path first: a direct line to a human. -->
    <div class="mt-8 rounded-2xl border border-line bg-surface p-6 sm:p-7">
      <p class="leading-relaxed text-ink-muted">
        Need help with {name}? Email me directly — no forms, no bots. I respond within {responseTime}.
      </p>
      <a
        href={mailto}
        class="mt-5 inline-flex items-center gap-2 rounded-lg bg-ink px-5 py-2.5 text-sm font-medium text-bg transition-[translate,scale,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-12px_var(--app-accent)] active:scale-[0.97]"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        {supportEmail}
      </a>
    </div>

    {
      quickStart.length > 0 && (
        <section>
          <h2 class="mt-14 font-display text-xl font-medium tracking-tight">Quick start</h2>
          <dl class="mt-4 divide-y divide-line border-y border-line">
            {quickStart.map((row) => (
              <div class="flex flex-col gap-1 py-4 sm:flex-row sm:gap-6">
                <dt class="shrink-0 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted sm:w-28 sm:pt-0.5">
                  {row.label}
                </dt>
                <dd class="leading-relaxed">{row.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      faq.length > 0 && (
        <section>
          <h2 class="mt-14 font-display text-xl font-medium tracking-tight">Common questions</h2>
          <div class="mt-4 divide-y divide-line border-y border-line">
            {faq.map((item) => (
              <details class="faq group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium [&::-webkit-details-marker]:hidden">
                  {item.q}
                  <span
                    class="shrink-0 text-ink-muted transition-transform duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <p class="faq-answer pb-5 leading-relaxed text-ink-muted">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      privacyNote && (
        <section class="mt-14 rounded-2xl border border-line bg-surface p-6 sm:p-7">
          <p class="eyebrow">Privacy</p>
          <p class="mt-2 leading-relaxed text-ink-muted">{privacyNote}</p>
          <p class="mt-3">
            <a
              href={`/${slug}/privacy/`}
              class="font-mono text-xs text-accent underline underline-offset-4"
            >
              Read the full privacy policy →
            </a>
          </p>
        </section>
      )
    }

    <p class="mt-12 font-mono text-xs text-ink-muted">
      Contact: <a href={mailto} class="text-accent underline underline-offset-4">{supportEmail}</a>
    </p>
  </div>
</BaseLayout>

<style>
  .faq-answer {
    animation: faq-open 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>
