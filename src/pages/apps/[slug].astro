---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps', ({ data }) => data.published);
  return apps.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const appSlug = entry.data.slug ?? entry.slug;
const { name, tagline, description, icon, screenshots, accent, platforms, releaseDate } =
  entry.data;
const { appStoreUrl, playStoreUrl, webUrl, downloadUrl } = entry.data;
const { Content } = await entry.render();

const platformLabels: Record<string, string> = {
  ios: 'iOS',
  android: 'Android',
  web: 'Web',
  windows: 'Windows',
  macos: 'macOS',
  linux: 'Linux',
};
const meta = [
  platforms.map((p) => platformLabels[p]).join(' · '),
  `Released ${new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' }).format(releaseDate)}`,
]
  .filter(Boolean)
  .join('  ·  ');
---

<BaseLayout title={`${name} — Tess It`} description={description}>
  <div style={`--app-accent: var(--su-${accent})`}>
    <!-- App hero -->
    <section class="relative overflow-hidden">
      <div class="app-glow" aria-hidden="true"></div>

      <div class="mx-auto max-w-3xl px-6 pb-16 pt-12 sm:pt-16">
        <a
          href="/#apps"
          class="font-mono text-xs uppercase tracking-[0.14em] text-ink-muted transition-colors hover:text-ink"
        >
          ← All apps
        </a>

        <div class="mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8">
          <img
            src={icon}
            alt=""
            width="112"
            height="112"
            class="size-24 rounded-[26px] shadow-lg sm:size-28"
            transition:name={`app-icon-${appSlug}`}
          />
          <div>
            <h1 class="font-display text-4xl font-medium tracking-tight sm:text-5xl">{name}</h1>
            <p class="mt-3 max-w-md text-lg leading-relaxed text-ink-muted">{tagline}</p>
          </div>
        </div>

        <p class="eyebrow mt-8">{meta}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          {
            appStoreUrl && (
              <a href={appStoreUrl} rel="noopener" class="store-btn">
                <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                  <path d="M17.05 20.28c-.96.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09v-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
                </svg>
                App Store
              </a>
            )
          }
          {
            playStoreUrl && (
              <a href={playStoreUrl} rel="noopener" class="store-btn">
                <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                  <path d="M3 2.7v18.6c0 .3.3.5.6.4l10.8-9.3c.2-.2.2-.5 0-.7L3.6 2.3c-.3-.1-.6.1-.6.4zm13.4 7.5-2.5 2.1 2.5 2.1 3.2-1.6c.5-.3.5-.8 0-1.1l-3.2-1.5z" />
                </svg>
                Google Play
              </a>
            )
          }
          {
            webUrl && (
              <a href={webUrl} rel="noopener" class="store-btn">
                <svg
                  viewBox="0 0 24 24"
                  class="size-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z" />
                </svg>
                Open in browser
              </a>
            )
          }
          {
            downloadUrl && (
              <a href={downloadUrl} rel="noopener" class="store-btn">
                <svg
                  viewBox="0 0 24 24"
                  class="size-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M12 3v12m0 0 5-5m-5 5-5-5M4 21h16" />
                </svg>
                Download
              </a>
            )
          }
        </div>
      </div>
    </section>

    <!-- Screenshots -->
    {
      screenshots && screenshots.length > 0 && (
        <section class="reveal mt-4" aria-label={`${name} screenshots`}>
          <div
            class="screenshot-rail mx-auto flex max-w-3xl snap-x snap-mandatory gap-5 overflow-x-auto px-6 pb-4"
            tabindex="0"
            role="region"
            aria-label="Screenshots, scroll horizontally"
          >
            {screenshots.map((src, i) => (
              <img
                src={src}
                alt={`${name} screenshot ${i + 1}`}
                width="390"
                height="844"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="w-60 shrink-0 snap-center rounded-3xl border border-line bg-surface sm:w-64"
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- Description -->
    <section class="reveal mx-auto max-w-3xl px-6 pt-16">
      <h2 class="heading-rule font-display text-2xl font-medium tracking-tight sm:text-3xl">
        About {name}
      </h2>
      <article class="app-prose mt-8">
        <Content />
      </article>
    </section>

    <!-- Support / Privacy -->
    <section class="mx-auto max-w-3xl px-6 pt-16">
      <div class="grid gap-4 sm:grid-cols-2">
        <a href={`/apps/${appSlug}/support/`} class="helper-card group">
          <p class="eyebrow">Support</p>
          <p class="mt-2 font-display text-lg font-medium">
            Need a hand with {name}?
            <span class="text-accent transition-transform group-hover:translate-x-0.5">→</span>
          </p>
        </a>
        <a href={`/apps/${appSlug}/privacy/`} class="helper-card group">
          <p class="eyebrow">Privacy</p>
          <p class="mt-2 font-display text-lg font-medium">
            What this app knows about you
            <span class="text-accent transition-transform group-hover:translate-x-0.5">→</span>
          </p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Soft radial wash in the app's own accent color behind the hero. */
  .app-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(560px 320px at 18% 0%, var(--app-accent), transparent 70%);
    opacity: 0.12;
  }

  :global(.dark) .app-glow {
    opacity: 0.16;
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    background: var(--su-ink);
    color: var(--su-bg);
    padding: 0.625rem 1.125rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -12px var(--app-accent);
  }

  .store-btn:active {
    transform: translateY(0) scale(0.97);
  }

  .screenshot-rail {
    scrollbar-width: thin;
    scrollbar-color: var(--su-border) transparent;
  }

  .heading-rule {
    position: relative;
    padding-bottom: 0.85rem;
  }

  .heading-rule::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 56px;
    border-radius: 2px;
    background: var(--app-accent);
  }

  .helper-card {
    display: block;
    border-radius: 1rem;
    border: 1px solid var(--su-border);
    background: var(--su-surface);
    padding: 1.25rem 1.5rem;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .helper-card:hover {
    transform: translateY(-2px);
    border-color: var(--app-accent);
  }

  .helper-card:active {
    transform: translateY(0) scale(0.99);
  }

  /* Hand-rolled prose styles for the MDX body (no typography plugin needed). */
  .app-prose :global(p) {
    margin-top: 1rem;
    line-height: 1.75;
    color: var(--su-ink-muted);
  }

  .app-prose :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--su-ink);
  }

  .app-prose :global(h3) {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--su-ink);
  }

  .app-prose :global(a) {
    color: var(--su-accent-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .app-prose :global(ul) {
    margin-top: 1rem;
    list-style: disc;
    padding-left: 1.5rem;
    color: var(--su-ink-muted);
  }

  .app-prose :global(li) {
    margin-top: 0.4rem;
    line-height: 1.7;
  }

  .app-prose :global(strong) {
    color: var(--su-ink);
    font-weight: 600;
  }
</style>
