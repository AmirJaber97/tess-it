---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps', ({ data }) => data.published);
  return apps.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const appSlug = entry.data.slug ?? entry.slug;
const { name, icon, accent } = entry.data;

const lastUpdated = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(
  entry.data.releaseDate
);

// Placeholder policy sections — replace with each app's real policy.
const sections = [
  {
    title: 'What gets collected',
    body: `Lorem ipsum dolor sit amet, consectetur adipiscing elit. ${name} does not collect, store, or transmit any personal information. There are no accounts, no tracking, and no third-party analytics SDKs.`,
  },
  {
    title: 'Data that stays on your device',
    body: 'Sed ut perspiciatis unde omnis iste natus error sit voluptatem. Your sessions, settings, and statistics are stored locally on your device. If you enable iCloud sync, that data is stored in your personal iCloud account, which I cannot access.',
  },
  {
    title: 'Purchases',
    body: 'Ut enim ad minima veniam, quis nostrum exercitationem. Payments are processed entirely by Apple. I receive anonymized sales reports and never see your payment details.',
  },
  {
    title: 'Changes to this policy',
    body: 'Quis autem vel eum iure reprehenderit qui in ea voluptate. If this policy ever changes, the date above will be updated and meaningful changes will be called out in the App Store release notes.',
  },
  {
    title: 'Contact',
    body: 'Questions about privacy? Email privacy@tess-it.net and I will get back to you.',
  },
];
---

<BaseLayout
  title={`${name} Privacy Policy — Tess It`}
  description={`Privacy policy for ${name}.`}
>
  <div class="mx-auto max-w-2xl px-6 pt-12" style={`--app-accent: var(--su-${accent})`}>
    <a
      href={`/apps/${appSlug}/`}
      class="inline-flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted transition-colors hover:text-ink"
    >
      <img
        src={icon}
        alt=""
        width="24"
        height="24"
        class="size-6 rounded-md"
        transition:name={`app-icon-${appSlug}`}
      />
      ← {name}
    </a>

    <p class="eyebrow mt-12">Privacy</p>
    <h1 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">
      {name} privacy policy
    </h1>
    <p class="mt-4 font-mono text-xs text-ink-muted">Last updated {lastUpdated}</p>

    <!-- The answer most visitors came for, up front. -->
    <div class="tldr mt-8 rounded-2xl border border-line bg-surface p-6 sm:p-7">
      <p class="eyebrow">The short version</p>
      <p class="mt-3 leading-relaxed">
        {name} collects <strong>nothing</strong>. No accounts, no ads, no analytics, no data
        leaving your device. The long version below exists because lawyers like long versions.
      </p>
    </div>

    <div class="mt-6">
      {
        sections.map((section) => (
          <section>
            <h2 class="mt-10 font-display text-xl font-medium tracking-tight">{section.title}</h2>
            <p class="mt-3 leading-relaxed text-ink-muted">{section.body}</p>
          </section>
        ))
      }
    </div>

    <p class="mt-14 font-mono text-xs text-ink-muted">
      Need help instead? Visit <a
        href={`/apps/${appSlug}/support/`}
        class="text-accent underline underline-offset-4">{name} support</a
      >.
    </p>
  </div>
</BaseLayout>

<style>
  .tldr {
    border-left: 4px solid var(--app-accent);
  }
</style>
