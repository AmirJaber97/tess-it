---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';

const apps = (await getCollection('apps', ({ data }) => data.published)).sort(
  (a, b) => b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf()
);

// Lead with one app, big and product-led; the rest fall into a grid below.
const [featured, ...rest] = apps;
const f = featured?.data;
const fSlug = f?.slug ?? featured?.slug;
const fStore = f?.platforms.includes('macos') ? 'mac' : 'ios';
const fShowBadge = !!f && (f.platforms.includes('macos') || f.platforms.includes('ios'));
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div id="hero-glow" class="absolute inset-0 -z-10 will-change-transform" aria-hidden="true">
      <div class="glow-blob glow-blob-a"></div>
      <div class="glow-blob glow-blob-b"></div>
      <div class="horizon-grid"></div>
    </div>

    <div class="mx-auto max-w-5xl px-6 pb-24 pt-20 sm:pb-32 sm:pt-28">
      <p class="eyebrow hero-enter">tess-it — indie app studio</p>
      <h1
        class="hero-enter mt-5 max-w-3xl font-display text-4xl font-medium leading-[1.08] tracking-tight sm:text-6xl"
        style="--enter-delay: 90ms"
      >
        Small apps, <span class="text-accent">carefully made</span>.
      </h1>
      <p
        class="hero-enter mt-6 max-w-xl text-lg leading-relaxed text-ink-muted"
        style="--enter-delay: 180ms"
      >
        I&rsquo;m Emir, an indie developer from Ukraine building useful tools for Mac, mobile, and
        the web.
      </p>
      <div class="hero-enter mt-10 flex flex-wrap gap-3" style="--enter-delay: 270ms">
        <a
          href="#apps"
          class="rounded-lg bg-tangerine px-5 py-2.5 text-sm font-medium text-[#fffdf7] transition-[translate,scale] duration-200 hover:-translate-y-0.5 active:scale-[0.97] dark:text-[#16141f]"
        >
          Browse apps
        </a>
        <a
          href="/contact/"
          class="rounded-lg border border-line px-5 py-2.5 text-sm font-medium transition-[border-color,scale] duration-200 hover:border-tangerine active:scale-[0.97]"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <!-- Apps -->
  <section id="apps" class="mx-auto max-w-5xl scroll-mt-12 px-6 pt-8 sm:pt-12">
    <p class="eyebrow reveal">01 / Apps</p>
    <h2 class="heading-rule reveal mt-4 font-display text-3xl font-medium tracking-tight sm:text-4xl">
      What I&rsquo;m building
    </h2>

    {
      featured && (
        <div class="reveal mt-12" style={`--app-accent: var(--su-${f.accent})`}>
          <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
            <a href={`/${fSlug}/`} class="featured-media group order-2 lg:order-1">
              <img
                src={f.screenshots?.[0] ?? f.icon}
                alt={`${f.name} screenshot`}
                width="1280"
                height="800"
                loading="eager"
                class="aspect-[16/10] w-full rounded-2xl border border-line bg-surface object-cover transition-transform duration-300 group-hover:-translate-y-1"
              />
            </a>
            <div class="order-1 lg:order-2">
              <div class="flex items-center gap-3">
                <img
                  src={f.icon}
                  alt=""
                  width="48"
                  height="48"
                  class="size-11 rounded-[14px]"
                  transition:name={`app-icon-${fSlug}`}
                />
                <p class="eyebrow">Featured app</p>
              </div>
              <h3 class="mt-5 font-display text-3xl font-medium tracking-tight">{f.name}</h3>
              <p class="mt-3 max-w-md text-lg leading-relaxed text-ink-muted">{f.tagline}</p>
              {fShowBadge && (
                <div class="mt-7">
                  <AppStoreBadge url={f.appStoreUrl} store={fStore} />
                </div>
              )}
              <a
                href={`/${fSlug}/`}
                class="mt-6 inline-flex items-center gap-1.5 font-medium text-accent underline decoration-2 underline-offset-4 transition-colors hover:decoration-magenta"
              >
                Explore {f.name}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      )
    }

    {
      rest.length > 0 && (
        <>
          <p class="eyebrow reveal mt-20">More apps</p>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((app, i) => (
              <AppCard app={app} index={i} />
            ))}
          </div>
        </>
      )
    }
  </section>

  <!-- About snippet -->
  <section class="mx-auto max-w-5xl px-6 pt-24 sm:pt-32">
    <p class="eyebrow reveal">02 / About</p>
    <h2 class="heading-rule reveal mt-4 font-display text-3xl font-medium tracking-tight sm:text-4xl">
      Hi, I&rsquo;m Emir
    </h2>
    <div class="reveal mt-8 max-w-2xl space-y-4 leading-relaxed text-ink-muted">
      <p>
        I&rsquo;m a developer from Ukraine who&rsquo;s been building software for over a decade —
        seventeen commercial projects across mobile, web, and desktop. These days I put that
        experience into apps of my own: small, colorful, carefully made tools.
      </p>
      <p>
        <a
          href="/about/"
          class="font-medium text-accent underline decoration-2 underline-offset-4 transition-colors hover:decoration-magenta"
        >
          More about me →
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Above-the-fold entrance: pure CSS so it needs no JS and runs on load.
     The global reduced-motion override disables it. */
  .hero-enter {
    animation: hero-enter 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--enter-delay, 0s);
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Featured app screenshot: soft accent-tinted lift. */
  .featured-media img {
    box-shadow: 0 20px 50px -32px var(--app-accent, transparent);
  }
  .featured-media:hover img {
    box-shadow: 0 26px 60px -28px var(--app-accent, transparent);
  }

  /* Ambient sunset glow: two blurred blobs drifting very slowly. The mask
     fades the layer out before the section edge so overflow-hidden never
     cuts the blur with a hard seam (also matters while parallaxing). */
  #hero-glow {
    mask-image: linear-gradient(to bottom, black 45%, transparent 85%);
  }

  .glow-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.1;
  }

  :global(.dark) .glow-blob {
    opacity: 0.14;
  }

  .glow-blob-a {
    width: 480px;
    height: 480px;
    top: -160px;
    left: -120px;
    background: var(--su-tangerine);
    animation: drift-a 26s ease-in-out infinite alternate;
  }

  .glow-blob-b {
    width: 420px;
    height: 420px;
    top: -60px;
    right: -140px;
    background: var(--su-magenta);
    animation: drift-b 32s ease-in-out infinite alternate;
  }

  @keyframes drift-a {
    to {
      transform: translate(70px, 50px) scale(1.12);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate(-60px, 70px) scale(1.08);
    }
  }

  /* Faint retro horizon: horizontal scanlines fading toward the top. */
  .horizon-grid {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--su-border) 0,
      var(--su-border) 1px,
      transparent 1px,
      transparent 56px
    );
    mask-image: linear-gradient(to top, rgb(0 0 0 / 0.7), transparent 75%);
  }

  /* Section headings get a short sunset underline that draws in on reveal. */
  .heading-rule {
    position: relative;
    padding-bottom: 0.85rem;
  }

  .heading-rule::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 64px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--su-tangerine) 0 25%,
      var(--su-magenta) 25% 50%,
      var(--su-golden) 50% 75%,
      var(--su-teal) 75% 100%
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }

  .heading-rule:global(.is-revealed)::after,
  html:not(.js) .heading-rule::after {
    transform: scaleX(1);
  }
</style>

<script>
  // Subtle hero parallax: the glow layer scrolls at ~1/5 speed.
  // Registered once; element is re-looked-up after each view transition.
  let glow: HTMLElement | null = null;
  let ticking = false;

  const onScroll = () => {
    if (!glow || ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      if (glow) glow.style.transform = `translateY(${window.scrollY * 0.2}px)`;
      ticking = false;
    });
  };

  document.addEventListener('astro:page-load', () => {
    glow = document.getElementById('hero-glow');
    if (glow) onScroll();
  });
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
